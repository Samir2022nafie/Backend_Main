###
# @name UpdatePost
# Update post (Author only)
PATCH {{baseUrl}}/posts/{{postId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Exploring the Northern Ridge (Updated with Map)",
  "content": "Updated notes with detailed parking and water point instructions.",
  "tags": ["hiking", "trail", "maps"]
}

### Expected Response: 200 OK
# {
#   "success": true,
#   "data": {
#     "id": "b1c2d3e4-1111-2222-3333-444455556666",
#     "communityId": "9b706d01-7c43-4e2e-a158-372beccc3d22",
#     "title": "Exploring the Northern Ridge (Updated with Map)",
#     "content": "Updated notes with detailed parking and water point instructions.",
#     "mediaUrl": "https://example.com/photos/northern-ridge.jpg",
#     "createdAt": "2026-09-03T05:00:00.000Z",
#     "updatedAt": "2026-09-03T05:10:00.000Z",
#     "author": {
#       "id": "5ee949e8-b14b-4a26-be3e-16a444b8599d",
#       "username": "johndoe",
#       "name": "John Doe",
#       "first_name": "John",
#       "last_name": "Doe",
#       "profile_picture_url": null
#     },
#     "tags": ["hiking", "trail", "maps"]
#   }
# }

### Error Example: 403 Forbidden (Non-author attempts update)
# {
#   "success": false,
#   "error": {
#     "code": "FORBIDDEN",
#     "message": "Only the author can update this post"
#   }
# }

###
# @name ToggleReaction
# Toggle reaction (like) on a post
POST {{baseUrl}}/posts/{{postId}}/react
Authorization: Bearer {{authToken}}
Accept: application/json

### Expected Response: 201 Created
# {
#   "success": true,
#   "data": {
#     "reacted": true,
#     "reactionCount": 5
#   }
# }

###
# @name ToggleSave
# Toggle save (bookmark) on a post
POST {{baseUrl}}/posts/{{postId}}/save
Authorization: Bearer {{authToken}}
Accept: application/json

### Expected Response: 201 Created
# {
#   "success": true,
#   "data": {
#     "saved": true
#   }
# }

###
# @name DeletePost
# Soft delete post (Author OR Admin/Mod/Owner of community)
DELETE {{baseUrl}}/posts/{{postId}}
Authorization: Bearer {{authToken}}
Accept: application/json

### Expected Response: 200 OK
# {
#   "success": true,
#   "data": {
#     "success": true
#   }
# }
