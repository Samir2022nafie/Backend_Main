###
# @name ListCommunityReports
# List reports scoped to a specific community (Admin/Mod/Owner)
GET {{baseUrl}}/communities/{{communitySlug}}/reports?page=1&limit=20
Authorization: Bearer {{authToken}}
Accept: application/json

###
# @name ListCommunityModerationActions
# List moderation action history for a community (Admin/Mod/Owner)
GET {{baseUrl}}/communities/{{communitySlug}}/moderation-actions?page=1&limit=20
Authorization: Bearer {{authToken}}
Accept: application/json

###
# @name ListCommunityBannedUsers
# List all users banned from events and hangouts in the community
GET {{baseUrl}}/admin/communities/{{communitySlug}}/banned-users
Authorization: Bearer {{authToken}}
Accept: application/json
