###
# @name UpdateComment
# Update comment content (Author only)
PATCH {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json
Accept: application/json

{
  "content": "Is there a clean water source near the 5km milestone? (Clarification: potable)"
}

### Expected Response: 200 OK
# {
#   "success": true,
#   "data": {
#     "id": "c1c2c3c4-1111-2222-3333-444455556666",
#     "postId": "b1c2d3e4-1111-2222-3333-444455556666",
#     "parentCommentId": null,
#     "content": "Is there a clean water source near the 5km milestone? (Clarification: potable)",
#     "createdAt": "2026-09-03T05:30:00.000Z",
#     "updatedAt": "2026-09-03T05:35:00.000Z",
#     "author": {
#       "id": "5ee949e8-b14b-4a26-be3e-16a444b8599d",
#       "username": "johndoe",
#       "name": "John Doe",
#       "first_name": "John",
#       "last_name": "Doe",
#       "profile_picture_url": null
#     }
#   }
# }

### Error Example: 403 Forbidden (Non-author attempts update)
# {
#   "success": false,
#   "error": {
#     "code": "FORBIDDEN",
#     "message": "Only the author can update this comment"
#   }
# }

###
# @name ToggleCommentReaction
# Toggle reaction (like) on comment
POST {{baseUrl}}/comments/{{commentId}}/react
Authorization: Bearer {{authToken}}
Accept: application/json

### Expected Response: 201 Created
# {
#   "success": true,
#   "data": {
#     "reacted": true,
#     "reactionCount": 3
#   }
# }

###
# @name DeleteComment
# Soft delete comment (Author OR Admin/Mod/Owner of community via CASL)
DELETE {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{authToken}}
Accept: application/json

### Expected Response: 200 OK
# {
#   "success": true,
#   "data": {
#     "success": true
#   }
# }
